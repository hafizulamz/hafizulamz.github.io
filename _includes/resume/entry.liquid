{% comment %}
  One CV row: dates (or a short label) on the left, what and where on the right.
  Takes start/end (YYYY-MM-DD, or just YYYY) or a plain date, plus title, url, org, summary, items and location.
{% endcomment %}
{% assign when = include.date %}
{% if include.start and include.start != '' %}
  {% if include.start.size == 4 %}
    {% assign when = include.start | append: ' – ' | append: include.end %}
  {% else %}
    {% assign until = 'present' %}
    {% if include.end and include.end != '' %}
      {% assign until = include.end | date: '%b %Y' %}
    {% endif %}
    {% assign when = include.start | date: '%b %Y' | append: ' – ' | append: until %}
  {% endif %}
{% endif %}
<li class="cv-entry">
  <div class="cv-when">
    {{ when }}
    {% if include.location and include.location != '' %}
      <span class="cv-where">{{ include.location }}</span>
    {% endif %}
  </div>
  <div class="cv-what">
    {% if include.title and include.title != '' %}
      <h3 class="cv-title" data-toc-skip>
        {% if include.url and include.url != '' %}
          <a href="{{ include.url }}">{{ include.title }}</a>
        {% else %}
          {{ include.title }}
        {% endif %}
      </h3>
    {% endif %}
    {% if include.org and include.org != '' %}
      <p class="cv-org">{{ include.org }}</p>
    {% endif %}
    {% if include.summary and include.summary != '' %}
      <p class="cv-summary">{{ include.summary }}</p>
    {% endif %}
    {% if include.items and include.items.size > 0 %}
      <ul class="cv-items">
        {% for item in include.items %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</li>
