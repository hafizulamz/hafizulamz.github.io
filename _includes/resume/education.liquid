<ul class="cv-list">
  {% assign education = section | sort: 'startDate' | reverse %}
  {% for e in education %}
    {% assign degree = e.studyType %}
    {% if e.area and e.area != '' %}
      {% assign degree = degree | append: ' in ' | append: e.area %}
    {% endif %}
    {% include resume/entry.liquid start=e.startDate end=e.endDate location=e.location title=degree url=e.url org=e.institution %}
  {% endfor %}
</ul>
